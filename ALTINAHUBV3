   ToggleButtonElement.Parent = Container

   local Corner = Instance.new("UICorner")
   Corner.CornerRadius = UDim.new(0, 6)
   Corner.Parent = ToggleButtonElement

   if currentManagedList then table.insert(currentManagedList, ToggleButtonElement) end

   local state = false
   ToggleButtonElement.MouseButton1Click:Connect(function()
      state = not state
      ToggleButtonElement.Text = state and ("  " .. name .. ": [ ON ]") or ("  " .. name .. ": [ OFF ]")
      ToggleButtonElement.BackgroundColor3 = state and Color3.fromRGB(0, 160, 220) or Color3.fromRGB(35, 35, 45)
      callback(state)
   end)
end

