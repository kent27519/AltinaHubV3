local function isEnemy(player)
   if game.Teams and player.Team and LocalPlayer.Team then return player.Team ~= LocalPlayer.Team end
   return true
end

local espCache = {}
local function getEspObjects(player)
   if not espCache[player] then
      local box = Drawing.new("Square"); box.Visible = false; box.Thickness = 1.5; box.Filled = false
      local healthBarBack = Drawing.new("Square"); healthBarBack.Visible = false; healthBarBack.Thickness = 1; healthBarBack.Filled = true; healthBarBack.Color = Color3.fromRGB(0, 0, 0)
      local healthBar = Drawing.new("Square"); healthBar.Visible = false; healthBar.Thickness = 1; healthBar.Filled = true
      local nameLabel = Drawing.new("Text"); nameLabel.Visible = false; nameLabel.Size = 13; nameLabel.Center = true; nameLabel.Outline = true
      local bones = {Drawing.new("Line"), Drawing.new("Line"), Drawing.new("Line"), Drawing.new("Line"), Drawing.new("Line")}
      for _, b in ipairs(bones) do b.Visible = false; b.Thickness = 1.5 end
      espCache[player] = {Box = box, HealthBarBack = healthBarBack, HealthBar = healthBar, NameLabel = nameLabel, Bones = bones}
   end
   return espCache[player]
end

Players.PlayerRemoving:Connect(function(player)
   if espCache[player] then
      espCache[player].Box:Remove()
      espCache[player].HealthBarBack:Remove()
      espCache[player].HealthBar:Remove()
      espCache[player].NameLabel:Remove()
      for _, b in ipairs(espCache[player].Bones) do b:Remove() end
      espCache[player] = nil
   end
end)

RunService.RenderStepped:Connect(function()
   local viewportSize = Camera.ViewportSize
   local skyBlueColor = Color3.fromRGB(0, 200, 255)

   FOVDrawing.Position = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
   FOVDrawing.Radius = Settings.FOVRadius
   FOVDrawing.Color = skyBlueColor

   for _, flake in ipairs(UiFlakes) do
      local pos = flake.Object.Position
      local newY = pos.Y.Scale + flake.Speed
      local newX = pos.X.Scale + flake.Drift
      if newY > 1 then newY = 0 end
      if newX > 1 then newX = 0 elseif newX < 0 then newX = 1 end
      flake.Object.Position = UDim2.new(newX, 0, newY, 0)
   end

   local character = LocalPlayer.Character
   if character and character:FindFirstChild("Humanoid") then
      local humanoid = character.Humanoid
      if Settings.WalkSpeedEnabled and humanoid.WalkSpeed ~= Settings.WalkSpeedValue then humanoid.WalkSpeed = Settings.WalkSpeedValue end
      if Settings.JumpPowerEnabled then
         if not humanoid.UseJumpPower then humanoid.UseJumpPower = true end
         if humanoid.JumpPower ~= Settings.JumpPowerValue then humanoid.JumpPower = Settings.JumpPowerValue end
      end
   end

   if Settings.NoclipEnabled and character then
      for _, part in ipairs(character:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end
   end

   if Settings.FlyEnabled and character and character:FindFirstChild("HumanoidRootPart") and flyBodyVelocity and flyBodyGyro then
      flyBodyGyro.CFrame = Camera.CFrame
      local moveDirection = Vector3.new(0, 0, 0)
      if flyingKeys.W then moveDirection = moveDirection + Camera.CFrame.LookVector end
      if flyingKeys.S then moveDirection = moveDirection - Camera.CFrame.LookVector end
      if flyingKeys.A then moveDirection = moveDirection - Camera.CFrame.RightVector end
      if flyingKeys.D then moveDirection = moveDirection + Camera.CFrame.RightVector end
      if flyingKeys.Space then moveDirection = moveDirection + Vector3.new(0, 1, 0) end
      if flyingKeys.Shift then moveDirection = moveDirection - Vector3.new(0, 1, 0) end
      flyBodyVelocity.Velocity = moveDirection * Settings.FlySpeed
   end

   for _, player in ipairs(Players:GetPlayers()) do
      local objects = espCache[player] or getEspObjects(player)
      local showEsp = false
      local pChar = player.Character

      if player ~= LocalPlayer and pChar and isEnemy(player) then
         local humanoid = pChar:FindFirstChild("Humanoid")
         local rootPart = pChar:FindFirstChild("HumanoidRootPart")
         local head = pChar:FindFirstChild("Head")

         if humanoid and rootPart and head and humanoid.Health > 0 then
            local rootPos, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
            if onScreen then
               showEsp = true
               local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
               local legPos = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0))
               local height = math.abs(headPos.Y - legPos.Y)
               local width = height / 2
               local boxPos = Vector2.new(rootPos.X - width / 2, headPos.Y)

               if Settings.BoxEspEnabled then
                  objects.Box.Visible = true; objects.Box.Size = Vector2.new(width, height); objects.Box.Position = boxPos; objects.Box.Color = skyBlueColor
               else objects.Box.Visible = false end

               if Settings.NameEspEnabled then
                  objects.NameLabel.Visible = true; objects.NameLabel.Text = player.Name; objects.NameLabel.Position = Vector2.new(rootPos.X, boxPos.Y - 16); objects.NameLabel.Color = Color3.fromRGB(255, 255, 255)
               else objects.NameLabel.Visible = false end

               if Settings.HealthBarEnabled then
                  local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                  local barHeight = height * healthPercent
                  objects.HealthBarBack.Visible = true; objects.HealthBarBack.Size = Vector2.new(4, height); objects.HealthBarBack.Position = Vector2.new(boxPos.X - 6, boxPos.Y)
                  objects.HealthBar.Visible = true; objects.HealthBar.Size = Vector2.new(2, barHeight); objects.HealthBar.Position = Vector2.new(boxPos.X - 5, boxPos.Y + (height - barHeight))
                  objects.HealthBar.Color = Color3.fromRGB(255 - (healthPercent * 255), healthPercent * 255, 0)
               else
                  objects.HealthBarBack.Visible = false; objects.HealthBar.Visible = false
               end

               if Settings.SkeletonEspEnabled then
                  local leftArm = pChar:FindFirstChild("Left Arm") or pChar:FindFirstChild("LeftHand")
                  local rightArm = pChar:FindFirstChild("Right Arm") or pChar:FindFirstChild("RightHand")
                  local leftLeg = pChar:FindFirstChild("Left Leg") or pChar:FindFirstChild("LeftLowerLeg")
                  local rightLeg = pChar:FindFirstChild("Right Leg") or pChar:FindFirstChild("RightLowerLeg")
                  local hScr = Camera:WorldToViewportPoint(head.Position)
                  local tScr = Camera:WorldToViewportPoint(rootPart.Position)
                  
                  objects.Bones[1].Visible = true; objects.Bones[1].From = Vector2.new(hScr.X, hScr.Y); objects.Bones[1].To = Vector2.new(tScr.X, tScr.Y); objects.Bones[1].Color = skyBlueColor

                  local function setBone(index, limb)
                     if limb then
                        local lScr = Camera:WorldToViewportPoint(limb.Position)
                        objects.Bones[index].Visible = true; objects.Bones[index].From = Vector2.new(tScr.X, tScr.Y); objects.Bones[index].To = Vector2.new(lScr.X, lScr.Y); objects.Bones[index].Color = skyBlueColor
                     else objects.Bones[index].Visible = false end
                  end
                  setBone(2, leftArm); setBone(3, rightArm); setBone(4, leftLeg); setBone(5, rightLeg)
               else
                  for _, bone in ipairs(objects.Bones) do bone.Visible = false end
               end
            end
         end
      end

      if not showEsp then
         objects.Box.Visible = false; objects.NameLabel.Visible = false; objects.HealthBarBack.Visible = false; objects.HealthBar.Visible = false
         for _, bone in ipairs(objects.Bones) do bone.Visible = false end
      end
   end

   if Settings.AimbotEnabled and character and character:FindFirstChild("HumanoidRootPart") then
      local closestTarget = nil
      local shortestDistance = Settings.FOVRadius
      local localRootPos = character.HumanoidRootPart.Position

      for _, player in ipairs(Players:GetPlayers()) do
         if player ~= LocalPlayer and isEnemy(player) and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local humanoid = player.Character:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
               local rootPart = player.Character.HumanoidRootPart
               if (rootPart.Position - localRootPos).Magnitude <= Settings.MaxDistance then
                  local screenPos, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
                  if onScreen then
                     local distanceToCenter = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)).Magnitude
                     if distanceToCenter < shortestDistance then
                        shortestDistance = distanceToCenter
                        closestTarget = rootPart
                     end
                  end
               end
            end
         end
      end

      if closestTarget then
         Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestTarget.Position)
      end
   end
end)

