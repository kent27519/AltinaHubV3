local Settings = getgenv().AltinaHubSettings
local flyingKeys = getgenv().AltinaHubFlyingKeys
local FOVDrawing = getgenv().AltinaHubFOVDrawing
local UiFlakes = getgenv().AltinaHubUiFlakes or {}
local UIStroke = getgenv().AltinaHubMainUIStroke
local ToggleStroke = getgenv().AltinaHubToggleStroke
local ToggleLabel = getgenv().AltinaHubToggleLabel

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local Mouse = LocalPlayer:GetMouse()

Mouse.Button1Down:Connect(function()
   if Settings.ClickTpEnabled then
      local char = LocalPlayer.Character
      if char and char:FindFirstChild("HumanoidRootPart") and Mouse.Hit then
         char.HumanoidRootPart.CFrame = CFrame.new(Mouse.Hit.Position + Vector3.new(0, 3, 0))
      end
   end
end)

UserInputService.InputBegan:Connect(function(input, gp)
   if gp then return end
   if input.KeyCode == Enum.KeyCode.W then flyingKeys.W = true end
   if input.KeyCode == Enum.KeyCode.S then flyingKeys.S = true end
   if input.KeyCode == Enum.KeyCode.A then flyingKeys.A = true end
   if input.KeyCode == Enum.KeyCode.D then flyingKeys.D = true end
   if input.KeyCode == Enum.KeyCode.Space then flyingKeys.Space = true end
   if input.KeyCode == Enum.KeyCode.LeftShift then flyingKeys.Shift = true end
end)

UserInputService.InputEnded:Connect(function(input)
   if input.KeyCode == Enum.KeyCode.W then flyingKeys.W = false end
   if input.KeyCode == Enum.KeyCode.S then flyingKeys.S = false end
   if input.KeyCode == Enum.KeyCode.A then flyingKeys.A = false end
   if input.KeyCode == Enum.KeyCode.D then flyingKeys.D = false end
   if input.KeyCode == Enum.KeyCode.Space then flyingKeys.Space = false end
   if input.KeyCode == Enum.KeyCode.LeftShift then flyingKeys.Shift = false end
end)

UserInputService.JumpRequest:Connect(function()
   if Settings.InfJumpEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
      LocalPlayer.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
   end
end)

local function isEnemy(player)
   if game.Teams and player.Team and LocalPlayer.Team then return player.Team ~= LocalPlayer.Team end
   return true
end

local espCache = {}
local function getEspObjects(player)
   if not espCache[player] then
      local box = Drawing.new("Square"); box.Visible = false; box.Thickness = 1.5; box.Filled = false
      local healthBarBack = Drawing.new("Square"); healthBarBack.Visible = false; healthBarBack.Thickness = 1; healthBarBack.Filled = true; healthBarBack.Color = Color3.fromRGB(0, 0, 0)
      local healthBar = Drawing.new("Square"); healthBar.Visible = false; healthBar.Thickness = 1; healthBar.Filled = true
      local nameLabel = Drawing.new("Text"); nameLabel.Visible = false; nameLabel.Size = 13; nameLabel.Center = true; nameLabel.Outline = true
      local bones = {Drawing.new("Line"), Drawing.new("Line"), Drawing.new("Line"), Drawing.new("Line"), Drawing.new("Line")}
      for _, b in ipairs(bones) do b.Visible = false; b.Thickness = 1.5 end
      espCache[player] = {Box = box, HealthBarBack = healthBarBack, HealthBar = healthBar, NameLabel = nameLabel, Bones = bones}
   end
   return espCache[player]
end

Players.PlayerRemoving:Connect(function(player)
   if espCache[player] then
      espCache[player].Box:Remove()
      espCache[player].HealthBarBack:Remove()
      espCache[player].HealthBar:Remove()
      espCache[player].NameLabel:Remove()
      for _, b in ipairs(espCache[player].Bones) do b:Remove() end
      espCache[player] = nil
   end
end)

RunService.RenderStepped:Connect(function()
   local viewportSize = Camera.ViewportSize
   local currentThemeColor = Color3.fromRGB(0, 200, 255)

   if Settings.RainbowTheme then
      local hue = tick() % 5 / 5
      currentThemeColor = Color3.fromHSV(hue, 1, 1)
      if UIStroke then UIStroke.Color = currentThemeColor end
      if ToggleStroke then ToggleStroke.Color = currentThemeColor end
      if ToggleLabel then ToggleLabel.TextColor3 = currentThemeColor end
   else
      if UIStroke then UIStroke.Color = Color3.fromRGB(0, 150, 255) end
   end

   if FOVDrawing then
      FOVDrawing.Position = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
      FOVDrawing.Radius = Settings.FOVRadius
      FOVDrawing.Color = currentThemeColor
   end

   for _, flake in ipairs(UiFlakes) do
      if flake.Object then
         local pos = flake.Object.Position
         local newY = pos.Y.Scale + flake.Speed
         local newX = pos.X.Scale + flake.Drift
         if newY > 1 then newY = 0 end
         if newX > 1 then newX = 0 elseif newX < 0 then newX = 1 end
         flake.Object.Position = UDim2.new(newX, 0, newY, 0)
      end
   end

   local character = LocalPlayer.Character
   if character and character:FindFirstChild("Humanoid") then
      local humanoid = character.Humanoid
      if Settings.WalkSpeedEnabled and humanoid.WalkSpeed ~= Settings.WalkSpeedValue then humanoid.WalkSpeed = Settings.WalkSpeedValue end
      if Settings.JumpPowerEnabled then
         if not humanoid.UseJumpPower then humanoid.UseJumpPower = true end
         if humanoid.JumpPower ~= Settings.JumpPowerValue then humanoid.JumpPower = Settings.JumpPowerValue end
      end
   end

   if Settings.NoclipEnabled and character then
      for _, part in ipairs(character:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end
   end

   if Settings.FlyEnabled and character and character:FindFirstChild("HumanoidRootPart") and getgenv().AltinaHubFlyVelocity and getgenv().AltinaHubFlyGyro then
      getgenv().AltinaHubFlyGyro.CFrame = Camera.CFrame
      local moveDirection = Vector3.new(0, 0, 0)
      if flyingKeys.W then moveDirection = moveDirection + Camera.CFrame.LookVector end
      if flyingKeys.S then moveDirection = moveDirection - Camera.CFrame.LookVector end
      if flyingKeys.A then moveDirection = moveDirection - Camera.CFrame.RightVector end
      if flyingKeys.D then moveDirection = moveDirection + Camera.CFrame.RightVector end
      if flyingKeys.Space then moveDirection = moveDirection + Vector3.new(0, 1, 0) end
      if flyingKeys.Shift then moveDirection = moveDirection - Vector3.new(0, 1, 0) end
      getgenv().AltinaHubFlyVelocity.Velocity = moveDirection * Settings.FlySpeed
   end

   for _, player in ipairs(Players:GetPlayers()) do
      local objects = espCache[player] or getEspObjects(player)
      local showEsp = false
      local pChar = player.Character

      if player ~= LocalPlayer and pChar and isEnemy(player) then
         local humanoid = pChar:FindFirstChild("Humanoid")
         local rootPart = pChar:FindFirstChild("HumanoidRootPart")
         local head = pChar:FindFirstChild("Head")

         if humanoid and rootPart and head and humanoid.Health > 0 then
            local rootPos, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
            if onScreen then
               showEsp = true
               local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
               local legPos = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0))
               local height = math.abs(headPos.Y - legPos.Y)
               local width = height / 2
               local boxPos = Vector2.new(rootPos.X - width / 2, headPos.Y)

               if Settings.BoxEspEnabled then
                  objects.Box.Visible = true
                  objects.Box.Size = Vector2.new(width, height)
                  objects.Box.Position = boxPos
                  objects.Box.Color = currentThemeColor
               else
                  objects.Box.Visible = false
               end

               if Settings.HealthBarEnabled then
                  local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                  local barHeight = height * healthPercent
                  objects.HealthBarBack.Visible = true
                  objects.HealthBarBack.Size = Vector2.new(4, height)
                  objects.HealthBarBack.Position = Vector2.new(boxPos.X - 6, boxPos.Y)
                  
                  objects.HealthBar.Visible = true
                  objects.HealthBar.Size = Vector2.new(2, barHeight)
                  objects.HealthBar.Position = Vector2.new(boxPos.X - 5, boxPos.Y + (height - barHeight))
                  objects.HealthBar.Color = Color3.fromRGB(0, 255, 100)
               else
                  objects.HealthBarBack.Visible = false
                  objects.HealthBar.Visible = false
               end

               if Settings.NameEspEnabled then
                  objects.NameLabel.Visible = true
                  objects.NameLabel.Text = player.Name
                  objects.NameLabel.Position = Vector2.new(rootPos.X, boxPos.Y - 18)
                  objects.NameLabel.Color = Color3.fromRGB(255, 255, 255)
               else
                  objects.NameLabel.Visible = false
               end

               if Settings.SkeletonEspEnabled and pChar:FindFirstChild("Left Arm") and pChar:FindFirstChild("Right Arm") then
                  local function to2D(part)
                     local pos, vis = Camera:WorldToViewportPoint(part.Position)
                     return Vector2.new(pos.X, pos.Y), vis
                  end
                  local h2D, hVis = to2D(head)
                  local t2D, tVis = to2D(rootPart)
                  local la2D = to2D(pChar["Left Arm"])
                  local ra2D = to2D(pChar["Right Arm"])
                  
                  if hVis and tVis then
                     objects.Bones[1].Visible = true; objects.Bones[1].From = h2D; objects.Bones[1].To = t2D; objects.Bones[1].Color = currentThemeColor
                     objects.Bones[2].Visible = true; objects.Bones[2].From = h2D; objects.Bones[2].To = la2D; objects.Bones[2].Color = currentThemeColor
                     objects.Bones[3].Visible = true; objects.Bones[3].From = h2D; objects.Bones[3].To = ra2D; objects.Bones[3].Color = currentThemeColor
                  else
                     for _, b in ipairs(objects.Bones) do b.Visible = false end
                  end
               else
                  for _, b in ipairs(objects.Bones) do b.Visible = false end
               end
            end
         end
      end

      if not showEsp then
         objects.Box.Visible = false
         objects.HealthBarBack.Visible = false
         objects.HealthBar.Visible = false
         objects.NameLabel.Visible = false
         for _, b in ipairs(objects.Bones) do b.Visible = false end
      end
   end
end)

print("[AltinaHub] Part 4 and all subsystems fully initialized!")

