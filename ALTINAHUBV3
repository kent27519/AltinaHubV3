-- UI Component Generators
local currentManagedList = nil

local function CreateHeader(text)
   local HeaderButton = Instance.new("TextButton")
   HeaderButton.Size = UDim2.new(1, 0, 0, 30)
   HeaderButton.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
   HeaderButton.BackgroundTransparency = 0.5
   HeaderButton.Text = " " .. text .. "               ↓"
   HeaderButton.TextColor3 = Color3.fromRGB(0, 200, 255)
   HeaderButton.TextSize = 14
   HeaderButton.Font = Enum.Font.GothamBold
   HeaderButton.TextXAlignment = Enum.TextXAlignment.Left
   HeaderButton.ZIndex = 2
   HeaderButton.Parent = Container

   local Corner = Instance.new("UICorner")
   Corner.CornerRadius = UDim.new(0, 6)
   Corner.Parent = HeaderButton

   local isOpen = true
   local managedItems = {}

   HeaderButton.MouseButton1Click:Connect(function()
      isOpen = not isOpen
      if isOpen then
         HeaderButton.Text = " " .. text .. "               ↓"
      else
         HeaderButton.Text = " " .. text .. "               ↑"
      end
      for _, item in ipairs(managedItems) do
         item.Visible = isOpen
      end
   end)
   return HeaderButton, managedItems
end

local function CreateToggle(name, callback)
   local ToggleButtonElement = Instance.new("TextButton")
   ToggleButtonElement.Size = UDim2.new(1, 0, 0, 40)
   ToggleButtonElement.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
   ToggleButtonElement.Text = "  " .. name .. ": [ OFF ]"
   ToggleButtonElement.TextColor3 = Color3.fromRGB(0, 200, 255)
   ToggleButtonElement.TextSize = 13
   ToggleButtonElement.Font = Enum.Font.GothamMedium
   ToggleButtonElement.TextXAlignment = Enum.TextXAlignment.Left
   ToggleButtonElement.ZIndex = 2
   ToggleButtonElement.Parent = Container

   local Corner = Instance.new("UICorner")
   Corner.CornerRadius = UDim.new(0, 6)
   Corner.Parent = ToggleButtonElement

   if currentManagedList then table.insert(currentManagedList, ToggleButtonElement) end

   local state = false
   ToggleButtonElement.MouseButton1Click:Connect(function()
      state = not state
      if state then
         ToggleButtonElement.Text = "  " .. name .. ": [ ON ]"
         ToggleButtonElement.BackgroundColor3 = Color3.fromRGB(0, 160, 220)
         ToggleButtonElement.TextColor3 = Color3.fromRGB(0, 200, 255)
      else
         ToggleButtonElement.Text = "  " .. name .. ": [ OFF ]"
         ToggleButtonElement.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
         ToggleButtonElement.TextColor3 = Color3.fromRGB(0, 200, 255)
      end
      callback(state)
   end)
end

